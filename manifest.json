{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.1",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://i.ytimg.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "src/styles/glass.css"
      ],
      "js": [
        "src/content/settings.js",
        "src/content/contrast.js",
        "src/content/refract.js",
        "src/content/ambient.js",
        "src/content/thumbs.js",
        "src/content/main.js",
        "src/content/dev-reload.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "css": [
        "src/styles/glass.css",
        "src/styles/ani-gamer.css"
      ],
      "js": [
        "src/content/settings.js",
        "src/content/contrast.js",
        "src/content/refract.js",
        "src/content/ambient.js",
        "src/content/thumbs.js",
        "src/content/ani-gamer.js",
        "src/content/dev-reload.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*"
      ],
      "all_frames": true,
      "css": [
        "src/styles/live-chat.css"
      ],
      "js": [
        "src/content/settings.js",
        "src/content/frame.js"
      ],
      "run_at": "document_start"
    }
  ]
}
